# Copy to .env; backend-only secrets. Never commit your .env.
DATABASE_URL=sqlite:///./runtime/market.sqlite
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
DEMO_ENABLED=true
PARTNER_DATA_DISPLAY_APPROVED=false
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# sip = consolidated history ending >= 16 minutes ago; iex = partial venue.
ALPACA_FEED=sip
FRED_API_KEY=
# Replace with your real contact; SEC access stays disabled until configured.
SEC_USER_AGENT=
COLLECTORS_ENABLED=false
REFRESH_INTERVAL_SECONDS=1800
NEWS_RETENTION_DAYS=90
SESSION_HOURS=12
# NAS fields are deliberately unset. Configure only after discovery and approval.
NAS_BIND_IP=127.0.0.1
NAS_DATA_DIR=
NAS_BACKUP_DIR=
IMAGE_TAG=local
HISTORY_YEARS=5
# Do not enable without provider written consent covering storage.
FRED_STORAGE_PERMISSION_CONFIRMED=false
# Optional earnings calendar: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Company overview / analyst counts require premium access; leave false on free accounts.
ALPHA_VANTAGE_OVERVIEW_ENABLED=false

# Both researched-symbol price feeds; one shared batch per feed/minute while open and active.
INTRADAY_ENABLED=false
INTRADAY_REFRESH_SECONDS=60
