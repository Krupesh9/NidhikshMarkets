# NidhikshDesk environment. Copy to .env. All provider keys are optional: missing keys => mock/local data.
# --- Core ---
NEXTAUTH_SECRET=            # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:4200
DATABASE_URL="file:./dev.db" # relative to prisma/ ; phase two: postgresql://nidhikshdesk:nidhikshdesk@localhost:5433/nidhikshdesk
ENCRYPTION_KEY=             # 32-byte base64 (openssl rand -base64 32) for AES-256-GCM of user API keys

# --- Market data (chain: Massive/Polygon -> Nidhiksh local cache -> SEC EDGAR -> Mock) ---
MASSIVE_API_KEY=            # Massive (formerly Polygon.io) REST key; base https://api.massive.com, falls back to api.polygon.io
POLYGON_API_KEY=            # legacy alias for MASSIVE_API_KEY
SEC_USER_AGENT="Your Name your-email@example.com"
NIDHIKSH_DB_PATH="/Users/krupeshpatel/Documents/ChatGPT/Nidhiksh Markets/runtime/market.sqlite" # read-only
ALPHADESK_FORCE_MOCK=       # set to 1 to skip all real providers

# --- AI (missing key => Mock provider with canned synthesis + citations) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- Optional Google OAuth (button shown on /login only when set) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Alpaca market data (quotes + bars). Data API only; no trading.
ALPACA_ENDPOINT=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex
# Alpha Vantage (forward EPS / analyst consensus). Free tier 25 calls/day; cached 24h on disk.
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=               # FRED (free key): macro release dates for /calendar (CPI, jobs, GDP, PCE…), cached 12h
FMP_API_KEY=

# --- Production sign-in (Vercel) ---
# Owner login: the only account that can sign in when deployed. Demo "magic link" login is off in production.
PULSE_OWNER_EMAIL=
PULSE_OWNER_PASSWORD=
PULSE_OWNER_NAME=
# ALLOW_DEMO_LOGIN=1   # never set this on a public deployment
TRUST_PROXY=1
