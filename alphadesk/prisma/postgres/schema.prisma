// NidhikshDesk — phase-two Postgres + pgvector schema (mirror of prisma/schema.prisma with native Json).
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Organization {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  seats      Int      @default(5)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  users      User[]
}

model User {
  id            String    @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email         String    @unique
  name          String?
  role          String    @default("ANALYST") // ADMIN | ANALYST | VIEWER
  plan          String    @default("FREE")    // FREE | PRO | PRO_PLUS
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  credentials   ApiCredential[]

  @@index([orgId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiCredential {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String   // anthropic | gemini | polygon (massive)
  ciphertext String
  iv         String
  tag        String
  last4      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, provider])
  @@index([orgId])
  @@index([userId])
}

model Watchlist {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  name      String
  symbols   Json   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([userId])
}

model SavedScreen {
  id          String   @id @default(cuid())
  orgId       String
  userId      String
  name        String
  description String?
  filters     Json   @default("{}")
  columns     Json   @default("[]")
  sort        Json   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
  @@index([userId])
}

model Portfolio {
  id           String     @id @default(cuid())
  orgId        String
  userId       String
  name         String
  description  String?
  benchmark    String     @default("SPY")
  baseCurrency String     @default("USD")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  positions    Position[]

  @@index([orgId])
  @@index([userId])
}

model Position {
  id           String    @id @default(cuid())
  orgId        String
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  ticker       String
  quantity     Float     // negative = short
  costBasis    Float     // per-share
  targetWeight Float?
  sector       String?
  country      String?
  openedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([orgId])
  @@index([portfolioId])
  @@index([ticker])
  @@index([sector])
}

model Basket {
  id          String          @id @default(cuid())
  orgId       String
  userId      String
  name        String
  description String?
  thesis      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  holdings    BasketHolding[]

  @@index([orgId])
  @@index([userId])
}

model BasketHolding {
  id           String   @id @default(cuid())
  orgId        String
  basketId     String
  basket       Basket   @relation(fields: [basketId], references: [id], onDelete: Cascade)
  ticker       String
  targetWeight Float
  rationale    String?
  sector       String?
  createdAt    DateTime @default(now())

  @@index([orgId])
  @@index([basketId])
  @@index([ticker])
  @@index([sector])
}

model ResearchNote {
  id             String   @id @default(cuid())
  orgId          String
  authorId       String
  title          String
  question       String
  answerMarkdown String
  citations      Json   @default("[]")
  structured     Json   @default("{}")
  tickers        Json   @default("[]")
  threadId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orgId])
  @@index([authorId])
  @@index([createdAt])
}

model ChatThread {
  id        String        @id @default(cuid())
  orgId     String
  userId    String
  title     String
  tickers   Json        @default("[]")
  context   Json        @default("{}")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([orgId])
  @@index([userId])
  @@index([updatedAt])
}

model ChatMessage {
  id         String     @id @default(cuid())
  orgId      String
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role       String     // user | assistant | system | tool
  content    String
  citations  Json     @default("[]")
  toolCalls  Json     @default("[]")
  structured Json     @default("{}")
  provider   String?    // anthropic | gemini | mock
  model      String?
  createdAt  DateTime   @default(now())

  @@index([orgId])
  @@index([threadId])
  @@index([createdAt])
}

model Share {
  id          String    @id @default(cuid())
  orgId       String
  token       String    @unique
  itemType    String    // note | screen | portfolio | basket | thread
  itemId      String
  title       String
  snapshot    Json    @default("{}")
  createdById String
  visibility  String    @default("org") // org | link
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]

  @@index([orgId])
  @@index([createdById])
  @@index([itemType, itemId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  orgId     String
  shareId   String
  share     Share    @relation(fields: [shareId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([shareId])
  @@index([authorId])
}

model FeedItem {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  kind      String   // share | note | alert | comment
  title     String
  body      String?
  href      String?
  meta      Json   @default("{}")
  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([userId])
  @@index([createdAt])
}

model UsageCounter {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  period    String   // YYYY-MM
  aiQueries Int      @default(0)
  deepDives Json   @default("{}")
  updatedAt DateTime @updatedAt

  @@unique([userId, period])
  @@index([orgId])
  @@index([userId])
}

model AuditLog {
  id            String   @id @default(cuid())
  orgId         String
  userId        String?
  action        String
  target        String?
  meta          Json   @default("{}")
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([orgId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model DocumentChunk {
  id        String   @id @default(cuid())
  orgId     String?
  ticker    String?
  sourceId  String
  title     String
  url       String?
  text      String
  embedding Unsupported("vector(1536)")?
  kind      String   // filing | transcript | news | note
  date      DateTime?
  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([ticker])
  @@index([sourceId])
  @@index([date])
}
