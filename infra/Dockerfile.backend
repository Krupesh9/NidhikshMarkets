FROM python:3.14.0-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/backend
WORKDIR /app
COPY backend/requirements.lock ./backend/requirements.lock
RUN pip install --no-cache-dir --upgrade pip==26.3 && pip install --no-cache-dir -r backend/requirements.lock
COPY backend ./backend
RUN pip install --no-deps ./backend && groupadd -g 10001 research && useradd -u 10001 -g research -M research && mkdir -p /app/runtime /app/backups && chown -R research:research /app/runtime /app/backups
USER research
EXPOSE 8000
CMD ["sh", "-c", "python -m app.cli init && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1"]
